{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "growthub-brand-kit": {
      "type": "streamable-http",
      "url": "https://www.growthub.ai/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${GROWTHUB_API_TOKEN}"
      }
    },
    "growthub-ceo": {
      "type": "streamable-http",
      "url": "https://www.growthub.ai/api/v1/mcp/ceo",
      "headers": {
        "Authorization": "Bearer ${GROWTHUB_API_TOKEN}"
      }
    },
    "growthub-knowledge": {
      "type": "streamable-http",
      "url": "https://www.growthub.ai/api/v1/mcp/knowledge",
      "headers": {
        "Authorization": "Bearer ${GROWTHUB_API_TOKEN}"
      }
    }
  }
}
