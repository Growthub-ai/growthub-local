# Core adapter selectors
GROWTHUB_WORKSPACE_DEPLOY_TARGET=vercel
GROWTHUB_WORKSPACE_DATA_ADAPTER=provider-managed
GROWTHUB_WORKSPACE_AUTH_ADAPTER=provider-managed
GROWTHUB_WORKSPACE_PAYMENT_ADAPTER=none

# Integration mode
# - growthub-bridge: hosted Growthub account authority
# - byo-api-key: workspace-owned connection metadata
# - static: local starter catalog only
GROWTHUB_WORKSPACE_INTEGRATION_ADAPTER=growthub-bridge

# Nango thin adapter — row-scoped, not a workspace-wide adapter.
# Set NANGO_SECRET_KEY when any api-registry row has connectorKind: "nango".
# Cloud mode reaches Nango Cloud; self-hosted requires NANGO_HOST_URL.
NANGO_MODE=cloud
NANGO_HOST_URL=
NANGO_ENVIRONMENT=dev
NANGO_SECRET_KEY=

# Hosted bridge authority
GROWTHUB_BRIDGE_BASE_URL=https://www.growthub.ai
GROWTHUB_BRIDGE_INTEGRATIONS_PATH=/api/mcp/accounts
GROWTHUB_BRIDGE_ACCESS_TOKEN=
GROWTHUB_BRIDGE_USER_ID=

# Optional Windsor reporting lane.
# Hybrid first boot: keep growthub-bridge authority and set WINDSOR_API_KEY
# to mark Windsor AI + Google Sheets blended data connected locally.
GROWTHUB_WORKSPACE_REPORTING_ADAPTER=windsor
WINDSOR_API_KEY=

# Optional BYO connection metadata
GROWTHUB_WORKSPACE_BYO_CONNECTIONS_JSON=

# Optional payment/auth/database env selected by adapter values above
DATABASE_URL=
# Legacy workspace-persistence adapter only; these do not configure the
# inference completion cache.
QSTASH_KV_REST_URL=
QSTASH_KV_REST_TOKEN=
AUTH_SECRET=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional QStash scheduler/queue delivery. These values do not configure the
# Redis inference cache.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Governed local-model inference control plane.
# llama-server is supervised by the workspace and bound to 127.0.0.1.
# A local llama.cpp target MUST set one or more operator-approved artifact
# roots. Use the platform path delimiter (`:` on POSIX, `;` on Windows).
LLAMA_SERVER_BIN=llama-server
GROWTHUB_LLAMA_ARTIFACT_ROOTS=
GROWTHUB_LLAMA_MAX_INSTANCES=4

# Optional role-to-settings JSON for prefill_pool, decode_pool, and
# unified_pool. Only threads, ctxSize, batchSize, ubatchSize, and gpuLayers are
# accepted; workspace rows cannot set these process/hardware controls.
GROWTHUB_LLAMA_SERVER_CONFIG_JSON=

# Unsafe local diagnostic break-glass only. Keep false in production/release.
GROWTHUB_LLAMA_ALLOW_UNCONFINED_ARTIFACTS=false

# Optional shared completion cache. If unset, the cache is bounded and
# process-local. A unique deployment/tenant namespace is mandatory before
# Redis is enabled, whichever credential family below supplies the backend.
GROWTHUB_INFERENCE_CACHE_NAMESPACE=

# Explicit Growthub credentials take precedence when set.
GROWTHUB_INFERENCE_CACHE_REDIS_URL=
GROWTHUB_INFERENCE_CACHE_REDIS_TOKEN=

# Supplied server-side by the governed Upstash Redis add-on resource sync.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Injected by a Vercel Marketplace Redis resource.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional OpenAI-compatible embeddings endpoint for semantic cache matching.
# Without both URL and model, exact caching still works and semantic lookup is
# reported unavailable. The API key is optional for loopback/private services.
GROWTHUB_INFERENCE_EMBEDDINGS_URL=
GROWTHUB_INFERENCE_EMBEDDINGS_MODEL=
GROWTHUB_INFERENCE_EMBEDDINGS_API_KEY=

# Generic remote inference still requires the sandbox networkAllow + allowList
# policy. This comma-separated operator list is the additional approval for
# allowlisted hosts that resolve to private/link-local/reserved addresses.
GROWTHUB_INFERENCE_PRIVATE_NETWORK_ALLOWLIST=

# Read-only custom-model /test-source may contact only these comma-separated
# external hosts and resolve only these comma-separated secret-reference names.
# Authenticated remote verification requires both approvals.
GROWTHUB_INFERENCE_TEST_ALLOWLIST=
GROWTHUB_INFERENCE_TEST_AUTH_REFS=

# Optional OTLP/HTTP JSON trace exporter. TRACES_ENDPOINT takes precedence;
# otherwise /v1/traces is appended to OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional app settings
CRON_SECRET=
GROWTHUB_WORKSPACE_USER_ID=
