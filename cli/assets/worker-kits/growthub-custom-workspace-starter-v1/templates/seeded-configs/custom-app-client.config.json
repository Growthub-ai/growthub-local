  "provenance": {
    "createdBy": "cli",
    "mirrors": "growthub-custom-workspace-starter-v1",
    "note": "Client-interface isolate seed: reduced surface (rail + home dashboard + workflow canvas) projecting capability-graph and custom-model utilization truth. The model-training object is intentionally absent — the GH App governed bootstrap owns that injection.",
    "template": "custom-app-client",
    "templateKind": "workspace-template",
    "seedTemplate": {
      "generatedBy": "scripts/export-workspace-seed-template.mjs",
      "generatedFrom": "custom-app-client.variant.json",
      "contract": "Non-secret seeded starter: object schemas, dashboards, canvas tabs, workflow definitions, and API Registry env-key refs preserved; PII rows, run receipts, and test evidence stripped. Secrets stay in uncommitted .env.local, resolved by authRef env key name."
    }
  },
